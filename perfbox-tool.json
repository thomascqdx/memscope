          "help": "MB",
          "type": "number",
          "flag": "--leak-delta",
          "advanced": true
        },
        {
          "name": "leak_pct",
          "label": "进程泄漏 delta 相对门限",
          "help": "%",
          "type": "number",
          "flag": "--leak-pct",
          "advanced": true
        },
        {
          "name": "leak_r2",
          "label": "泄漏判定 R2 阈值",
          "type": "number",
          "flag": "--leak-r2",
          "advanced": true
        },
        {
          "name": "sys_leak_delta",
          "label": "层级/整机泄漏 delta 门限",
          "help": "MB",
          "type": "number",
          "flag": "--sys-leak-delta",
          "advanced": true
        },
        {
          "name": "rate_pct",
          "label": "LMK/压力频率对比阈值",
          "help": "%",
          "type": "number",
          "flag": "--rate-pct",
          "advanced": true
        }
      ],
      "output": {"flag": "-o", "kind": "dir"},
      "outputs": [
        {"glob": "**/report.html", "role": "report", "primary": true},
        {"glob": "**/report.md", "role": "report"},
        {"glob": "**/data.xlsx", "role": "data"}
      ]
    }
  ]
}
